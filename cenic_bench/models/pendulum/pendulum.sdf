<?xml version="1.0"?>
<!--
  A simple torque-controlled pendulum: a massless rod with a spherical bob,
  swinging about the world y-axis. At theta = 0 the pendulum hangs straight
  down; at theta = pi it is upright.
-->
<sdf version="1.9">
  <model name="pendulum">

    <!-- Fixed mount at the pivot, 1 m above the ground. -->
    <link name="base">
      <pose>0 0 1 0 0 0</pose>
      <visual name="mount">
        <pose>0 0.05 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.04 0.1</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="base_weld" type="fixed">
      <parent>world</parent>
      <child>base</child>
    </joint>

    <!-- The arm frame sits at the pivot; the bob hangs 0.5 m below it. -->
    <link name="arm">
      <pose relative_to="base">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.5 0 0 0</pose>
        <mass>0.5</mass>
        <!-- Solid sphere of radius 0.05 m: 2/5 m r^2 -->
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rod">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
      <visual name="bob">
        <pose>0 0 -0.5 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0.1 0.4 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- A nonzero effort limit makes Drake add an actuator for this joint. -->
    <joint name="theta" type="revolute">
      <parent>base</parent>
      <child>arm</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>1.0</effort>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

  </model>
</sdf>
