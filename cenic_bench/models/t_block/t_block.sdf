<?xml version="1.0"?>
<!--
  A T-shaped block that slides on a floor whose top is z = 0. The link
  origin is the center of the 0.2 m square around the T, at mid-height.
-->
<sdf version="1.9">
  <model name="t_block">

    <link name="t">
      <pose>0 0 0.025 0 0 0</pose>
      <inertial>
        <pose>0 0.032143 0 0 0 0</pose>
        <mass>0.5</mass>
        <!-- Two solid boxes, mass split by area, combined about the center
             of mass with the parallel axis theorem -->
        <inertia>
          <ixx>0.00179</ixx>
          <iyy>0.001101</iyy>
          <izz>0.002683</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="bar">
        <pose>0 0.075 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.8 0.4 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="bar">
        <pose>0 0.075 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.05 0.05</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>5e6</drake:hydroelastic_modulus>
          <drake:mu_dynamic>0.5</drake:mu_dynamic>
          <drake:mu_static>0.5</drake:mu_static>
        </drake:proximity_properties>
      </collision>
      <visual name="stem">
        <pose>0 -0.025 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.15 0.05</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.8 0.4 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="stem">
        <pose>0 -0.025 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.15 0.05</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>5e6</drake:hydroelastic_modulus>
          <drake:mu_dynamic>0.5</drake:mu_dynamic>
          <drake:mu_static>0.5</drake:mu_static>
        </drake:proximity_properties>
      </collision>
    </link>

  </model>
</sdf>
