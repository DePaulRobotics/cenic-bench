<?xml version="1.0"?>
<!--
  An acrobot: two identical uniform rods swinging about the world y-axis,
  with a passive shoulder and a torque-controlled elbow. At shoulder =
  elbow = 0 it hangs straight down; at shoulder = pi, elbow = 0 it points
  straight up.
-->
<sdf version="1.9">
  <model name="acrobot">

    <link name="base">
      <pose>0 0 1.2 0 0 0</pose>
      <visual name="shoulder">
        <pose>0 0 0 1.57079633 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="base_weld" type="fixed">
      <parent>world</parent>
      <child>base</child>
    </joint>

    <link name="upper_link">
      <pose relative_to="base">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.25 0 0 0</pose>
        <mass>0.5</mass>
        <!-- Solid cylinder r = 0.02 m, L = 0.5 m: m (3 r^2 + L^2) / 12
             across, m r^2 / 2 along -->
        <inertia>
          <ixx>0.010467</ixx>
          <iyy>0.010467</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rod">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.1 0.4 0.8 1</diffuse>
        </material>
      </visual>
      <visual name="elbow">
        <pose>0 0 -0.5 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="shoulder" type="revolute">
      <parent>base</parent>
      <child>upper_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>0</effort>
        </limit>
        <dynamics>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="lower_link">
      <pose relative_to="upper_link">0 0 -0.5 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.25 0 0 0</pose>
        <mass>0.5</mass>
        <!-- Solid cylinder r = 0.02 m, L = 0.5 m: m (3 r^2 + L^2) / 12
             across, m r^2 / 2 along -->
        <inertia>
          <ixx>0.010467</ixx>
          <iyy>0.010467</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rod">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.8 0.4 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="elbow" type="revolute">
      <parent>upper_link</parent>
      <child>lower_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>2.5</effort>
        </limit>
        <dynamics>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>

  </model>
</sdf>
