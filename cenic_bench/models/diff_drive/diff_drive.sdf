<?xml version="1.0"?>
<!--
  A differential drive robot: a box chassis on two torque-controlled wheels,
  with a frictionless caster sphere at the back. x points forward; positive
  torque on both wheels drives it forward.
-->
<sdf version="1.9">
  <model name="diff_drive">

    <link name="chassis">
      <pose>0 0 0.08 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <!-- Solid box 0.3 x 0.2 x 0.08 m: m (b^2 + c^2) / 12 about each
             axis -->
        <inertia>
          <ixx>0.007733</ixx>
          <iyy>0.016067</iyy>
          <izz>0.021667</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis">
        <geometry>
          <box>
            <size>0.3 0.2 0.08</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.4 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="chassis">
        <geometry>
          <box>
            <size>0.3 0.2 0.08</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>5e6</drake:hydroelastic_modulus>
        </drake:proximity_properties>
      </collision>
      <visual name="caster">
        <pose>-0.1 0 -0.06 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.02</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="caster">
        <pose>-0.1 0 -0.06 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.02</radius>
          </sphere>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>5e6</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.005</drake:mesh_resolution_hint>
          <drake:mu_dynamic>0</drake:mu_dynamic>
          <drake:mu_static>0</drake:mu_static>
        </drake:proximity_properties>
      </collision>
    </link>

    <link name="left_wheel">
      <pose relative_to="chassis">0.05 0.12 -0.03 -1.57079633 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <!-- Solid cylinder r = 0.05 m, L = 0.03 m: m (3 r^2 + L^2) / 12
             across, m r^2 / 2 along -->
        <inertia>
          <ixx>0.00007</ixx>
          <iyy>0.00007</iyy>
          <izz>0.000125</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="wheel">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>5e6</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.005</drake:mesh_resolution_hint>
        </drake:proximity_properties>
      </collision>
    </link>

    <joint name="left" type="revolute">
      <parent>chassis</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <effort>0.1</effort>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="right_wheel">
      <pose relative_to="chassis">0.05 -0.12 -0.03 -1.57079633 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <!-- Solid cylinder r = 0.05 m, L = 0.03 m: m (3 r^2 + L^2) / 12
             across, m r^2 / 2 along -->
        <inertia>
          <ixx>0.00007</ixx>
          <iyy>0.00007</iyy>
          <izz>0.000125</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="wheel">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>5e6</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.005</drake:mesh_resolution_hint>
        </drake:proximity_properties>
      </collision>
    </link>

    <joint name="right" type="revolute">
      <parent>chassis</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <effort>0.1</effort>
        </limit>
        <dynamics>
          <damping>0.005</damping>
        </dynamics>
      </axis>
    </joint>

  </model>
</sdf>
