<?xml version="1.0"?>
<!--
  A force-controlled cart sliding along the world x-axis, carrying an
  unactuated pole that swings about the world y-axis. The pole is a massless
  rod with a spherical bob. At theta = 0 the pole hangs straight down; at
  theta = pi it is upright. The rail is visual only and has no ends.
-->
<sdf version="1.9">
  <model name="cart_pole">

    <!-- Fixed rail, 1 m above the ground. -->
    <link name="rail">
      <pose>0 0 1 0 0 0</pose>
      <visual name="rail">
        <geometry>
          <box>
            <size>6 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rail_weld" type="fixed">
      <parent>world</parent>
      <child>rail</child>
    </joint>

    <link name="cart">
      <pose relative_to="rail">0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <!-- Solid box 0.3 x 0.2 x 0.15 m: m (b^2 + c^2) / 12 -->
        <inertia>
          <ixx>0.005208</ixx>
          <iyy>0.009375</iyy>
          <izz>0.010833</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="body">
        <geometry>
          <box>
            <size>0.3 0.2 0.15</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.8 0.4 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- A nonzero effort limit makes Drake add an actuator for this joint. -->
    <joint name="x" type="prismatic">
      <parent>rail</parent>
      <child>cart</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>10.0</effort>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- The pole frame sits at the pivot; the bob hangs 0.5 m below it. -->
    <link name="pole">
      <pose relative_to="cart">0 -0.12 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.5 0 0 0</pose>
        <mass>0.5</mass>
        <!-- Solid sphere of radius 0.05 m: 2/5 m r^2 -->
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rod">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
      <visual name="bob">
        <pose>0 0 -0.5 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0.1 0.4 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- A zero effort limit leaves the pole unactuated. -->
    <joint name="theta" type="revolute">
      <parent>cart</parent>
      <child>pole</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>0</effort>
        </limit>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

  </model>
</sdf>
