<?xml version="1.0"?>
<!--
  Two soft, frictionless, undamped walls for the cart-pole in
  cart_pole.sdf. Each wall's collision shape is a half-space, an infinite
  flat wall, with its face at x = +/-0.15 m and its normal pointing toward
  the center. Each wall is drawn as a translucent block covering every
  height the bob can reach; the walls are soft springs, so after the pole
  has fallen the bob can sink deep into the block before it is pushed back;
  the cart and rod pass through it because only the bob collides. The bob
  (r = 0.05 m) first touches a wall when its center is 0.1 m from the
  center.

  The cart and pole masses and the pole length in cart_pole.sdf match the
  cart-pole with soft walls in Aydinoglu, Preciado and Posa, ICRA 2020
  (arXiv:1909.11221), Section IV.A, and the wall distance d = 0.1 m is
  taken from it. That paper uses a wall stiffness of k = 10 N/m. We use
  k = 100 N/m because at k = 10 the wall is about as soft as gravity's
  tipping effect (m g / l ~ 9.8 N/m) and can't hold a leaning pole.

  The walls have point contact properties only. Under point contact or
  Drake's default hydroelastic-with-fallback model, the bob-wall pair
  uses point contact.
-->
<sdf version="1.9">
  <model name="soft_walls">

    <link name="left_wall">
      <pose>-0.25 -0.12 1.5 0 0 0</pose>
      <visual name="left_wall">
        <pose>-0.05 0 -0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.2 1.3</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.6 0.6 0.6 0.5</diffuse>
        </material>
      </visual>
      <collision name="left_wall">
        <pose>0.1 0 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>1 0 0</normal>
          </plane>
        </geometry>
        <drake:proximity_properties>
          <drake:point_contact_stiffness>100</drake:point_contact_stiffness>
          <drake:hunt_crossley_dissipation>0</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>0</drake:mu_dynamic>
          <drake:mu_static>0</drake:mu_static>
        </drake:proximity_properties>
      </collision>
    </link>

    <joint name="left_wall_weld" type="fixed">
      <parent>world</parent>
      <child>left_wall</child>
    </joint>

    <link name="right_wall">
      <pose>0.25 -0.12 1.5 0 0 0</pose>
      <visual name="right_wall">
        <pose>0.05 0 -0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.2 1.3</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.6 0.6 0.6 0.5</diffuse>
        </material>
      </visual>
      <collision name="right_wall">
        <pose>-0.1 0 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>-1 0 0</normal>
          </plane>
        </geometry>
        <drake:proximity_properties>
          <drake:point_contact_stiffness>100</drake:point_contact_stiffness>
          <drake:hunt_crossley_dissipation>0</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>0</drake:mu_dynamic>
          <drake:mu_static>0</drake:mu_static>
        </drake:proximity_properties>
      </collision>
    </link>

    <joint name="right_wall_weld" type="fixed">
      <parent>world</parent>
      <child>right_wall</child>
    </joint>

  </model>
</sdf>
