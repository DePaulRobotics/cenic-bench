<?xml version="1.0"?>
<!--
  Two walls for the cart-pole in cart_pole.sdf, one on each side. The walls are
  damped springs, like padded walls: when the bob hits one it only sinks in a
  few centimeters and loses energy on impact.

  Each wall's collision shape is a half-space, an infinite flat wall, with
  its face at x = +/-0.15 m and its normal pointing toward the center. The
  contact comes from the half-space, not from the drawn block. Each block
  is translucent, 0.2 m deep from the face outward, and covers every height
  the bob can reach. Only the bob collides; the cart and rod pass through
  the walls. The bob (r = 0.05 m) first touches a wall when its center is
  0.1 m from the center. The walls are frictionless.

  The walls set only point contact properties, so the bob-wall pair uses
  point contact under both point contact and Drake's default
  hydroelastic-with-fallback model.
-->
<sdf version="1.9">
  <model name="soft_walls">

    <link name="left_wall">
      <pose>-0.25 -0.12 1.5 0 0 0</pose>
      <visual name="left_wall">
        <pose>0 0 -0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.2 1.3</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.6 0.6 0.6 0.5</diffuse>
        </material>
      </visual>
      <collision name="left_wall">
        <pose>0.1 0 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>1 0 0</normal>
          </plane>
        </geometry>
        <drake:proximity_properties>
          <drake:point_contact_stiffness>1000</drake:point_contact_stiffness>
          <drake:hunt_crossley_dissipation>2</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>0</drake:mu_dynamic>
          <drake:mu_static>0</drake:mu_static>
        </drake:proximity_properties>
      </collision>
    </link>

    <joint name="left_wall_weld" type="fixed">
      <parent>world</parent>
      <child>left_wall</child>
    </joint>

    <link name="right_wall">
      <pose>0.25 -0.12 1.5 0 0 0</pose>
      <visual name="right_wall">
        <pose>0 0 -0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.2 1.3</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.6 0.6 0.6 0.5</diffuse>
        </material>
      </visual>
      <collision name="right_wall">
        <pose>-0.1 0 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>-1 0 0</normal>
          </plane>
        </geometry>
        <drake:proximity_properties>
          <drake:point_contact_stiffness>1000</drake:point_contact_stiffness>
          <drake:hunt_crossley_dissipation>2</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>0</drake:mu_dynamic>
          <drake:mu_static>0</drake:mu_static>
        </drake:proximity_properties>
      </collision>
    </link>

    <joint name="right_wall_weld" type="fixed">
      <parent>world</parent>
      <child>right_wall</child>
    </joint>

  </model>
</sdf>
