<?xml version="1.0"?>
<!--
  Unitree G1 humanoid (29 DOF), converted from mjlab's G1 model
  (https://github.com/mujocolab/mjlab, commit a6a76e59bf,
  src/mjlab/asset_zoo/robots/unitree_g1/xmls/g1.xml). See LICENSE.md.

  Kinematics, inertias, joint limits, and collision capsules/spheres are
  taken from g1.xml. Effort limits and armature (drake:rotor_inertia with
  gear ratio 1) come from mjlab's g1_constants.py. The 50 N m waist
  pitch/roll and ankle limits are mjlab's approximation of a two-motor
  linkage (2 x 25 N m), not a Unitree spec. Meshes are visual only.
-->
<sdf version="1.9" xmlns:drake="http://drake.mit.edu">
