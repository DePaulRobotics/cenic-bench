<?xml version="1.0"?>
<!--
  A spherical pusher driven in the world x and y directions by two
  force-controlled prismatic joints. At x = y = 0 the ball sits at the
  origin, 0.025 m above the floor.
-->
<sdf version="1.9">
  <model name="pusher">

    <link name="carriage">
      <pose>0 0 0.025 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>8e-6</ixx>
          <iyy>8e-6</iyy>
          <izz>8e-6</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="x" type="prismatic">
      <parent>world</parent>
      <child>carriage</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>5</effort>
        </limit>
        <dynamics>
          <damping>10</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="ball">
      <pose>0 0 0.025 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <!-- Solid sphere r = 0.02 m: 2 m r^2 / 5 -->
        <inertia>
          <ixx>1.6e-5</ixx>
          <iyy>1.6e-5</iyy>
          <izz>1.6e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="ball">
        <geometry>
          <sphere>
            <radius>0.02</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0.1 0.4 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="ball">
        <geometry>
          <sphere>
            <radius>0.02</radius>
          </sphere>
        </geometry>
        <drake:proximity_properties>
          <drake:rigid_hydroelastic/>
          <drake:mesh_resolution_hint>0.005</drake:mesh_resolution_hint>
        </drake:proximity_properties>
      </collision>
    </link>

    <joint name="y" type="prismatic">
      <parent>carriage</parent>
      <child>ball</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>5</effort>
        </limit>
        <dynamics>
          <damping>10</damping>
        </dynamics>
      </axis>
    </joint>

  </model>
</sdf>
